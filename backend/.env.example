# Copy the values you need into your shell environment (or a local .env file loaded by your IDE).
# Never commit real credentials or a real production JWT secret.

DB_URL=jdbc:mysql://localhost:3306/skill_sphere_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Generate a secure Base64 value of at least 32 bytes for real use.
JWT_SECRET=REPLACE_WITH_A_BASE64_SECRET_AT_LEAST_32_BYTES_LONG

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# This must also be registered in Google Cloud Console as an authorized redirect URI:
# http://localhost:8080/login/oauth2/code/google
FRONTEND_URL=http://localhost:5173
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:5173/oauth2/callback
FILE_UPLOAD_DIR=uploads
